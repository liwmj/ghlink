#!/bin/sh
# prerm: 卸载前动作（ghlink v0.2.0）
set -e

# 1. 停止并移除定时任务（如果已启用）
if command -v ghlink >/dev/null 2>&1; then
    ghlink disable 2>/dev/null || true
fi

# 2. 清理 systemd 残留（兜底）
if [ -f /etc/systemd/system/ghlink.timer ]; then
    systemctl disable --now ghlink.timer 2>/dev/null || true
    rm -f /etc/systemd/system/ghlink.timer /etc/systemd/system/ghlink.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi

# 3. 保留用户配置（conffile 机制自动处理 /etc/ghlink/config.json）

exit 0
