#!/bin/sh
# postinst: 安装后动作（ghlink v0.2.0）
# 默认不自启（opt-in）：安装只部署文件，用户运行 `ghlink enable` 启用值守
set -e

# 1. 安装 Python 包到系统（如果从源码包安装）
if command -v pip3 >/dev/null 2>&1; then
    pip3 install --no-deps --break-system-packages /usr/share/ghlink/ghlink-*.whl 2>/dev/null || true
fi

# 2. 创建配置目录（默认配置由 maintainer scripts 复制）
mkdir -p /etc/ghlink
if [ ! -f /etc/ghlink/config.json ]; then
    cp /usr/share/ghlink/config.example.json /etc/ghlink/config.json 2>/dev/null || true
fi

# 3. 状态目录
mkdir -p /var/lib/ghlink

exit 0
