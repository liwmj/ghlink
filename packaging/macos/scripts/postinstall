#!/bin/bash
# ghlink pkg postinstall（v0.4.12 Cask 方案，v0.4.19 加 sudoers 自动写入）
#
# 职责：
#   1. 注册 LaunchDaemon 模板（enable 时由 ghlink 正式注册，这里只保证可执行权限）
#   2. 确保 CLI wrapper 可执行
#   3. 自动写入 sudoers 提权规则（v0.4.19 李工：装机即用，拒绝手动配置）
#   4. 刷新 mds（可选，非必须）

set -e

# v0.4.25（赛博根因 2026-08-26，顾笙实测）：pkg 未签名 → 安装器 relocate 行为——
# /Applications 已有旧版时，新 app 被装到 ~/ghlink-test.app 而非 /Applications
# → 软链断、Launchpad 找不到、双击无反应。
# ⚠️ v0.4.25 安装失败根因（拂晓 12:44 命中，赛博确认）：原实现校验 app 不在
# /Applications 直接 exit 1 —— 但 relocate 场景下 app 必然不在 /Applications，
# postinstall 退出码非 0 → 安装器整体判定「安装失败」。改为**修复式落位**：
# 先尝试从 relocate 位置 ditto 归位，仍失败才 warning（绝不 exit 1）。
APP="/Applications/ghlink.app"
if [ ! -d "$APP" ]; then
  # 从安装器 relocate 位置找回（实测路径 ~/ghlink-test.app，console 用户目录）
  FOUND=""
  for cand in /Users/*/ghlink-test.app "$HOME/ghlink-test.app"; do
    if [ -d "$cand" ]; then
      FOUND="$cand"
      break
    fi
  done
  if [ -n "$FOUND" ] && command -v ditto >/dev/null 2>&1; then
    echo "[ghlink] 检测到安装器 relocate，从 $FOUND 归位到 /Applications"
    ditto "$FOUND" "$APP" && echo "[ghlink] 归位完成: $APP"
  fi
fi
if [ ! -d "$APP" ]; then
  # 落位失败仅警告，不阻断安装（postinstall 非 0 会让整个安装失败）
  echo "WARN: ghlink.app 未落位 /Applications，请安装后手动检查" >&2
fi
# LaunchServices 注册（双击/Launchpad 启动链路必需；ditto 复制场景未注册）
if [ -d "$APP" ] && [ -x "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister" ]; then
  "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister" -f "$APP" || true
fi

# CLI wrapper 权限 + v0.4.27（李工 13:33 实测：启动值守提示权限不足）
# 刀⑦：修复式归位（ditto 复制）后 /usr/local/bin/ghlink 软链可能失效——
# ditto 重建 .app 但软链指向旧 inode，sudoers NOPASSWD 放行路径不匹配 → 提权失败。
# 归位后强制重建软链 + 校验 sudoers 存在且路径匹配。
ln -sfn "$APP/Contents/MacOS/ghlink" /usr/local/bin/ghlink 2>/dev/null || true
chmod 0755 /usr/local/bin/ghlink 2>/dev/null || true
chmod 0755 "$APP/Contents/MacOS/ghlink-tray" 2>/dev/null || true

# 配置目录权限（root 属主，用户可读）
chown -R root:wheel /usr/local/etc/ghlink 2>/dev/null || true
chmod 0644 /usr/local/etc/ghlink/config.json 2>/dev/null || true

# v0.4.19（李工 22:16：装了就能用，不手动配）：自动写入 sudoers NOPASSWD 窄放行。
# 卸载自清（ghlink uninstall 的 _cleanup_uninstall_residue 会删）后重装 pkg 也自动补回。
# 用户取 console 登录用户（/dev/console），root 安装场景下仍写对归属。
CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null || echo '')"
if [ -n "$CONSOLE_USER" ]; then
  SUDOERS_D="/etc/sudoers.d/ghlink"
  if [ ! -f "$SUDOERS_D" ] || ! grep -q "ghlink" "$SUDOERS_D" 2>/dev/null; then
    cat > "$SUDOERS_D" <<EOS
# ghlink 托盘提权窄放行（v0.4.19 安装自动写入；卸载自清）
${CONSOLE_USER} ALL=(root) NOPASSWD: /usr/local/bin/ghlink
Defaults!/usr/local/bin/ghlink env_keep += "GH_TOKEN"
Defaults!/usr/local/bin/ghlink env_keep += "HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY"
EOS
    chmod 0440 "$SUDOERS_D"
  fi
fi

exit 0
